<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_goal_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_goal_background"
    android:clickable="true"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_goal_focus_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_goal_focus"
        android:textAllCaps="true"
        android:textColor="#FFC20A"
        android:textSize="10sp"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.13" />

    <TextView
        android:id="@+id/widget_goal_focus_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_goal_focus_label"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textColor="#F5F1E9"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed" />

    <TextView
        android:id="@+id/widget_goal_focus_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/widget_goal_focus_days"
        android:layout_toEndOf="@id/widget_goal_focus_days"
        android:layout_marginStart="5dp"
        android:text="@string/widget_days_left"
        android:textAllCaps="true"
        android:textColor="#FFC20A"
        android:textSize="10sp"
        android:fontFamily="sans-serif-condensed" />

    <TextView
        android:id="@+id/widget_goal_focus_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#C2BFBA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed" />
</RelativeLayout>
