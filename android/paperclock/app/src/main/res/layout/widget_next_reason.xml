<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_next_background"
    android:clickable="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/widget_next_toggle"
        android:layout_width="62dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/widget_editorial_toggle"
        android:gravity="center"
        android:textColor="#0B0B0C"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-condensed" />

    <LinearLayout
        android:id="@+id/widget_next_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_toStartOf="@id/widget_next_toggle"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_next_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textColor="@color/widget_sun"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-condensed" />
        <TextView
            android:id="@+id/widget_next_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_secondary_ink"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_next_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_rule"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/widget_reason_to_rise"
            android:textColor="@color/widget_secondary_ink"
            android:textSize="9sp"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-condensed" />
        <TextView
            android:id="@+id/widget_next_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_next_header"
        android:layout_above="@id/widget_next_footer"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/widget_next_dawn"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/widget_dawn"
            android:importantForAccessibility="no" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/widget_next_dawn"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/widget_next_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/widget_next_period"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="60sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/widget_text"
                android:textSize="60sp"
                android:textStyle="bold"
                android:letterSpacing="-0.045"
                android:fontFamily="sans-serif-condensed" />
            <TextView
                android:id="@id/widget_next_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBaseline="@id/widget_next_time"
                android:textColor="@color/widget_secondary_ink"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-condensed" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
