{
	"name": "jonaylor.com",
	"version": "1.0.0",
	"description": "personal website monorepo",
	"main": "index.js",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"deploy": "turbo run deploy",
		"android:paperclock:build": "cd android/paperclock && ./gradlew assembleDebug",
		"android:saintjohn:build": "cd android/saintjohn && ./gradlew assembleDebug",
		"android:parlo:build": "cd android/parlo && ./gradlew assembleDebug",
		"macos:fuego:build": "cd macos/fuego && xcodebuild -project Fuego.xcodeproj -scheme Fuego -configuration Debug CODE_SIGNING_ALLOWED=NO build",
		"prego:check": "cd flutter/prego && flutter pub get --enforce-lockfile && dart format --output=none --set-exit-if-changed lib test && flutter analyze --no-pub && flutter test --no-pub",
		"prego:build": "cd flutter/prego && flutter build apk --debug",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check ."
	},
	"keywords": [],
	"author": "Johannes Naylor <me@jonaylor.com>",
	"license": "MIT",
	"packageManager": "pnpm@10.32.1",
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"turbo": "^2.8.15",
		"typescript": "~5.1.6",
		"wrangler": "4.148.0"
	}
}
