# Copy to .env on the server. Never commit actual deployment details.
# Literal values only: no quotes, whitespace, substitutions, or inline comments.
APPDATA_DIR=/srv/appdata
# Keep downloads and libraries on the same filesystem for hardlinks/atomic moves.
MEDIA_DIR=/srv/media
# Exact mountpoint containing MEDIA_DIR. Use / explicitly for root-disk storage.
MEDIA_MOUNT=/srv/media
PUID=1000
PGID=1000
TZ=Etc/UTC
# Loopback by default. Access with SSH forwarding or change locally to a private IP.
BIND_ADDRESS=127.0.0.1
