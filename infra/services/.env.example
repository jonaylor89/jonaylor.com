# Copy to .env and configure locally. Never commit credentials or server identities.
APPDATA_DIR=/srv/services
BIND_ADDRESS=127.0.0.1
PUID=1000
PGID=1000
TZ=Etc/UTC

HUB_BASE_URL=https://hub.example.com
HUB_HMAC_SECRET=replace-with-a-random-secret
EMAIL_SENDER=newsletter@example.com
POSTMARK_TOKEN=replace-with-a-postmark-token

GITEA_DOMAIN=git.example.com
GITEA_ROOT_URL=https://git.example.com/
GITEA_SSH_PORT=2222

# Only needed when explicitly enabling the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
