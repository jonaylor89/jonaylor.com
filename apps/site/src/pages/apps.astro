---
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const apps = [
	{
		name: "Paper Clock",
		index: "01",
		description: "A private, offline alarm clock for building mornings around meaningful goals.",
		platform: "Android 8.0+",
		downloadUrl: "https://downloads.jonaylor.com/paperclock.apk",
		releaseUrl: "https://github.com/jonaylor89/jonaylor.com/releases",
		sourceUrl: "https://github.com/jonaylor89/jonaylor.com/tree/main/android/paperclock",
	},
	{
		name: "Saint John",
		index: "02",
		description:
			"A distraction-free Android launcher with local-first tools and an AI home screen.",
		platform: "Android 8.0+",
		downloadUrl: "https://downloads.jonaylor.com/saintjohn.apk",
		releaseUrl: "https://github.com/jonaylor89/jonaylor.com/releases",
		sourceUrl: "https://github.com/jonaylor89/jonaylor.com/tree/main/android/saintjohn",
	},
];
---

<BaseLayout
	title="Apps - Johannes Naylor"
	description="Install Android apps by Johannes Naylor, with future desktop and iOS releases in one place."
>
	<Navigation />

	<main class="mx-auto min-h-screen max-w-4xl px-5 py-10 md:px-10 md:py-16">
		<header class="border-b-2 border-text pb-10 md:pb-12">
			<p class="mb-5 font-mono text-xs tracking-[0.22em] text-text-muted">SOFTWARE CATALOG / 2026</p>
			<h1 class="max-w-2xl text-4xl font-bold tracking-tight md:text-5xl">Things to install.</h1>
			<p class="mt-5 max-w-xl text-lg leading-relaxed text-text-secondary">
				Small, deliberate software for the devices you already carry. Direct downloads, release
				notes, and source code—without an app-store maze.
			</p>
		</header>

		<section class="py-10 md:py-14" aria-labelledby="available-apps">
			<div class="mb-5 flex items-baseline justify-between gap-4">
				<h2 id="available-apps" class="font-mono text-xs tracking-[0.2em] text-text-muted">
					AVAILABLE NOW
				</h2>
				<p class="text-xs text-text-muted">LATEST RELEASES</p>
			</div>

			<div class="divide-y-2 divide-default border-y-2 border-default">
				{apps.map((app) => (
					<article class="grid gap-6 py-8 md:grid-cols-[4rem_1fr_auto] md:items-end md:gap-8 md:py-10">
						<p class="font-mono text-sm text-text-muted">{app.index}</p>
						<div>
							<p class="mb-3 inline-flex border border-default px-2 py-1 font-mono text-[0.65rem] tracking-[0.16em] text-text-secondary">
								ANDROID · {app.platform.toUpperCase()}
							</p>
							<h3 class="text-2xl font-bold tracking-tight">{app.name}</h3>
							<p class="mt-2 max-w-xl leading-relaxed text-text-secondary">{app.description}</p>
							<div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
								<a
									href={app.sourceUrl}
									target="_blank"
									rel="noreferrer"
									class="underline decoration-default underline-offset-4 transition-opacity hover:opacity-60"
								>
									Source code
								</a>
								<a
									href={app.releaseUrl}
									target="_blank"
									rel="noreferrer"
									class="underline decoration-default underline-offset-4 transition-opacity hover:opacity-60"
								>
									Release notes
								</a>
							</div>
						</div>
						<a
							href={app.downloadUrl}
							class="inline-flex min-h-12 items-center justify-center bg-accent-bg px-5 py-3 text-sm font-semibold text-accent-text transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-text"
						>
							Download APK <span class="ml-2" aria-hidden="true">↓</span>
						</a>
					</article>
				))}
			</div>
		</section>

		<aside class="border-l-2 border-text bg-surface-muted px-5 py-6 md:px-7" aria-label="Android install note">
			<p class="font-mono text-xs tracking-[0.18em] text-text-muted">A NOTE ON ANDROID</p>
			<p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">
				APK downloads open in your browser. Android may ask you to allow installs from that browser;
				only do so after confirming the download came from this page. Each button resolves to the
				newest matching GitHub Release.
			</p>
		</aside>

		<section class="mt-12 border-t border-default pt-8 md:mt-16" aria-labelledby="coming-next">
			<h2 id="coming-next" class="font-mono text-xs tracking-[0.2em] text-text-muted">COMING NEXT</h2>
			<p class="mt-3 max-w-2xl text-text-secondary">
				This catalog is platform-neutral by design. macOS DMGs, iOS App Store or TestFlight links,
				and future releases will live here beside Android.
			</p>
		</section>
	</main>

	<Footer />
</BaseLayout>
