      <p class="summary">{resume.summary} · {resume.location}</p>

      <!-- Employment -->
      <section>
        <h2 class="section-header">Employment</h2>
        {resume.employment.map((job) => (
          <div class="subsection">
            <div class="subsection-header">
              <span class="location">{job.location}</span>
              <span>
                {job.url ? (
                  <a class="company" href={job.url} target="_blank" rel="noopener">{job.company}</a>
                ) : (
                  <span class="company">{job.company}</span>
                )}
                <span class="title"> · {job.title}</span>
              </span>
              <span class="period">{job.period}</span>
            </div>
            <ul>
              {job.note && <li class="note">{job.note}</li>}
              {job.bullets?.map((bullet) => <li set:html={bullet} />)}
              {job.tech && <li class="tech-stack">{job.tech.join(", ")}</li>}
            </ul>
          </div>
        ))}
      </section>

      <!-- Skills -->
