      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Nunito", sans-serif;
        background: #fff;
        color: #333;
        line-height: 1.4;
        margin: 0;
      }

      @media print {
        .no-print {
          display: none !important;
        }
        .resume-container {
          max-width: none !important;
          padding: 0 !important;
          margin: 0 !important;
        }
        body {
          background: white !important;
        }
      }

      .resume-container {
        width: 20cm;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        max-width: none !important;
      }

      .alert {
        background: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
        padding: 0.75rem;
        margin: 20px 0 1rem 0;
        border-radius: 4px;
        text-align: center;
        font-size: 0.9rem;
      }

      .header-table {
        width: 100%;
        margin-bottom: 0.5rem;
      }

      .header-table td {
        vertical-align: middle;
      }

      .header-table .name {
        text-align: center;
        font-size: 1.5rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .header-table a {
        color: #333;
        text-decoration: underline;
      }

      .section-header {
        border-top: 3px solid #444;
        padding-top: 0.4rem;
        margin-top: 1rem;
        font-size: 1rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .subsection {
        border-top: 2px solid #ccc;
        padding: 0.4rem 0;
      }

      .subsection-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        font-weight: 600;
      }

      .subsection-header .location {
        color: #666;
        font-size: 0.9rem;
        font-weight: normal;
      }

      .subsection-header .period {
        font-style: italic;
        font-size: 0.9rem;
        color: #666;
        font-weight: normal;
      }

      .subsection-header .company {
        letter-spacing: 0.5px;
      }

      .subsection ul {
        margin: 0.3rem 0 0 1.5rem;
        font-size: 0.9rem;
      }

      .subsection li {
        margin-bottom: 0.1rem;
      }

      .tech-stack {
        list-style: none;
        margin-left: 0;
        font-style: italic;
        color: #666;
      }

      .summary {
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        margin-bottom: 0.5rem;
      }

      .skill-list {
        font-size: 0.9rem;
        padding: 0.4rem 0;
      }

      .skill-row {
        margin-bottom: 0.15rem;
      }

      .skill-row strong {
        font-weight: 700;
      }

      .subsection-header .title {
        font-weight: normal;
      }

      .note {
        list-style: none;
        margin-left: -1.5rem;
        font-style: italic;
        color: #666;
      }

      .icon {
        display: inline-block;
        width: 16px;
        height: 16px;
        vertical-align: middle;
        margin-right: 4px;
        fill: currentColor;
      }

      .icon-lg {
        width: 20px;
        height: 20px;
      }

      a {
        color: inherit;
        text-decoration: underline;
      }
    </style>
